{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bober Server Manager",
  "version": "0.1.1",
  "identifier": "com.bober.tauripoc",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bober Server Manager",
        "url": "app.html",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/sidecar-bin", "binaries/bot-bin"],
    "targets": ["deb", "msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/RaptorSauvage/test-manager-ark/releases/latest/download/latest.json"],
